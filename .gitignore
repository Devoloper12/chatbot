# =====================================================================
# Git Ignore Configuration
# =====================================================================

# Environment variables & secrets (NEVER commit your secret API keys!)
.env
*.env
!.env.example

# Local SQLite Database (Contains your conversation history)
chatbot.db
*.sqlite3
*.db-journal

# Saved user code and exports
saved_code/
exports/

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
