# =============================================================================
# Terminal AI Chatbot - Multi-Provider Configuration Template
# =============================================================================
# Provider Priority: Groq (Primary) -> OpenRouter (Secondary) -> Ollama (Fallback)
# =============================================================================

# 1. Groq (Primary - Free & Ultra-Fast)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2. OpenRouter (Secondary - Multi-model aggregation & free tier)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# 3. Ollama (Fallback - Local offline models)
# Install & run locally from: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
