# =====================================================================
# Google Gemini Terminal Chatbot - Configuration
# =====================================================================
# Copy this file to .env and fill in your actual Gemini API key.
#
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/
# =====================================================================

# Required: Your Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (defaults to gemini-2.5-flash if omitted)
# Options:
#   - gemini-2.5-flash (fast, highly capable, default)
#   - gemini-1.5-flash (widely supported lightweight model)
#   - gemini-1.5-pro   (complex reasoning)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Automatically extract and save code blocks to saved_code/ (true/false)
AUTO_SAVE_CODE=false

