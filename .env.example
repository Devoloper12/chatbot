# =====================================================================
# Terminal AI Chatbot - Configuration
# =====================================================================
# Powered by Groq (Primary, Ultra-Fast & Free) with Gemini Support
#
# Get your free Groq API key (5 seconds, no credit card):
# 👉 https://console.groq.com/keys
# =====================================================================

# Required: Your Groq API Key (starts with gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq Model (defaults to llama-3.3-70b-versatile)
# Options:
#   - llama-3.3-70b-versatile (State-of-the-art 70B, best for coding & DSA)
#   - llama-3.1-8b-instant    (Ultra-fast, lowest latency)
#   - deepseek-r1-distill-llama-70b (DeepSeek reasoning model)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Alternative: Google Gemini API Key
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Automatically save extracted code blocks to saved_code/ (true/false)
AUTO_SAVE_CODE=false
